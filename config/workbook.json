        "C": {
          "unit": "平方千米",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原值印度1656780、中国1275799、美国1652028；FAO资料将印度耕地规模表为约165百万公顷，换算为约165万平方千米，与原记录尺度一致。C是面积，不能直接贴“公顷”；与D=C*G*1000/Y的量纲关系另在未定项列出。",
            "sourceUrls": [
              "https://www.fao.org/4/ag088e/AG088E06.htm"
            ]
          }
        },
        "F": {
          "unit": "千克/人/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式E*1000/Y；E明确为吨、Y为人数，乘1000换成千克后按人分配；表头“年人均谷物”明确年度尺度。",
            "sourceUrls": []
          }
        },
        "I": {
          "unit": "吨/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原值美国47461240、中国97496360、印度12833298为年度肉类产量规模；FAOSTAT livestock primary生产数量单位为吨。H=I*600/Y与吨转千克后折粮的关系相容；不改变肉类的品种范围。",
            "sourceUrls": [
              "https://data.fao.org/catalog/iso/55375b1e-51d0-47db-ac9b-536ac8a1c738"
            ]
          }
        },
        "H": {
          "unit": "千克谷物当量/人/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式I*600/Y，等同于吨肉量×1000×原式0.6再除人口；PDF第8页明确按可替代谷物热量折算，故为按原式折算的人均谷物当量，不是饲料耗粮量。0.6仅复述既有公式系数，不新增换算。",
            "sourceUrls": [
              "https://data.fao.org/catalog/iso/55375b1e-51d0-47db-ac9b-536ac8a1c738"
            ]
          }
        },
        "K": {
          "unit": "吨/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原值美国3161390、中国6362305、印度7081116及加总式（中国5994800+367505等）符合纤维作物年产量公吨尺度；FAOSTAT作物生产资料使用吨。只确认质量单位，不更改加总范围或原值。",
            "sourceUrls": [
              "https://data.fao.org/catalog/dataset/0f0db364-04e5-4f54-a96d-da6f5657b356",
              "https://files-faostat.fao.org/production/QCL/QCL_methodology_e.pdf"
            ]
          }
        },
        "J": {
          "unit": "千克/人/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式K*1000/Y，K为吨/年、Y为人数。虽然表头为“人均衣物”，该原式直接对应纤维产量人均质量，不能把数值标作件/人或服装消费量。",
            "sourceUrls": [
              "https://data.fao.org/catalog/dataset/0f0db364-04e5-4f54-a96d-da6f5657b356"
            ]
          }
        },
        "M": {
          "unit": "千公顷",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "美国309795、中国219978、加拿大346928、俄罗斯815312、印度72160与FAO森林面积表以1000 ha表示的记录一致；不是平方千米。FAO/CIFOR原发布表用于识别单位，未补入该表年份或外部数值。",
            "sourceUrls": [
              "https://www.cifor-icraf.org/publications/pdf/reports/45870-FAO-Agroforestry-for-wood-production.pdf",
              "https://www.fao.org/forest-resources-assessment/past-assessments/fra-2020/"
            ]
          }
        },
        "N": {
          "unit": "千卡/人/日",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原表头“每日热量”，数值多在约2500—3900，与FAO食物平衡表kcal/cap/day体系一致。只确认热量与人日尺度，继续保留“供应量还是实际摄入量未精确定义”的现有说明。",
            "sourceUrls": [
              "https://www.fao.org/statistics/highlights-archive/highlights-detail/food-balance-sheets-2010-2022-global-regional-and-country-trends/"
            ]
          }
        },
        "P": {
          "unit": "立方米/人/年",
