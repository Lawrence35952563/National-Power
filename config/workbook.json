        "B": {
          "role": "identity"
        },
        "C": {
          "name": "未命名辅助字段（C列）",
          "role": "auxiliary"
        },
        "D": {
          "unit": "%",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式 D=E+F；记录如美国 43.8=25.6+18.2，属于百分数点刻度，不是0—1比值。PDF第14页解释可再生及核电发电占比；只确认单位，不据此扩展“其他”的能源构成。",
            "sourceUrls": [
              "https://pris.iaea.org/PRIS/PRIS_poster_2024.pdf"
            ]
          }
        },
        "E": {
          "unit": "%",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原值如加拿大63.9、美国25.6、中国37，与PDF第14页发电占比概念及D=E+F一致；使用百分数点刻度，原值无需乘100。不得解释为全部能源消费占比。",
            "sourceUrls": [
              "https://pris.iaea.org/PRIS/PRIS_poster_2024.pdf"
            ]
          }
        },
        "F": {
          "unit": "%",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "PDF第14页核电发电占比；法国原值67.3与IAEA PRIS表中核电供电占比百分数尺度相符，且D=E+F。仅核对单位，不更新数值或观测年。",
            "sourceUrls": [
              "https://pris.iaea.org/PRIS/PRIS_poster_2024.pdf"
            ]
          }
        },
        "G": {
          "unit": "比值（1=100%）",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原公式为W/Y：石油产量/石油消耗，同单位量相除，无乘100。原值1表示供需相等；可以大于1，不能在未换算时直接标为%。energy-L虽名为“煤炭综合”，实际公式仍为该比值。",
            "sourceUrls": []
          }
        },
        "M": {
          "unit": "比值（1=100%）",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原公式为Q/S：天然气产量/天然气消耗，同单位量相除，无乘100。原值1表示供需相等；可以大于1，不能在未换算时直接标为%。energy-L虽名为“煤炭综合”，实际公式仍为该比值。",
            "sourceUrls": []
          }
        },
        "L": {
          "unit": "比值（1=100%）",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原公式为T/V：煤炭产量/煤炭消耗，同单位量相除，无乘100。原值1表示供需相等；可以大于1，不能在未换算时直接标为%。energy-L虽名为“煤炭综合”，实际公式仍为该比值。",
            "sourceUrls": []
          }
        },
        "H": {
          "unit": "年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式 X*1000000/W/365；X为百万桶、W为桶/日，换算得到年；PDF第14页定义按当前产量估算的储采年限。是时间跨度，不是公历耗尽年份。",
            "sourceUrls": [
              "https://www.eia.gov/tools/faqs/faq.php?id=709&t=6"
            ]
          }
        },
        "N": {
          "unit": "年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式 R*1000/Q；R按十亿立方米、Q按百万立方米/年，换算得到年；PDF第14页定义储采年限。保留既有除零错误，不补零、不改公式。",
            "sourceUrls": [
              "https://www.eia.gov/naturalgas/annual/pdf/nga24.pdf"
            ]
          }
        },
        "Q": {
          "unit": "百万立方米/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "天然气产量原值美国分别约1069431与936799，中国约258444与424888；EIA Natural Gas Annual表B1采用年度百万立方米尺度且数量级对应。原式R*1000/Q和Q/S进一步约束尺度；不宣称这些值已逐年对齐EIA版本。",
            "sourceUrls": [
              "https://www.eia.gov/naturalgas/annual/pdf/nga24.pdf"
            ]
          }
        },
        "S": {
          "unit": "百万立方米/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "天然气消耗原值美国分别约1069431与936799，中国约258444与424888；EIA Natural Gas Annual表B1采用年度百万立方米尺度且数量级对应。原式R*1000/Q和Q/S进一步约束尺度；不宣称这些值已逐年对齐EIA版本。",
            "sourceUrls": [
              "https://www.eia.gov/naturalgas/annual/pdf/nga24.pdf"
            ]
          }
        },
        "R": {
          "unit": "十亿立方米",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原值俄罗斯47800、美国17710、中国6650；结合Q的百万立方米/年和N=R*1000/Q，R必须按十亿立方米计才能使储采年限为年。只补单位，不为储量值指定新年份或来源版本。",
            "sourceUrls": [
              "https://www.eia.gov/naturalgas/annual/pdf/nga24.pdf"
            ]
          }
        },
        "T": {
          "unit": "百万吨/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "煤炭产量原值美国464.969/372.798，与EIA年度约512.5/410.9百万短吨经公吨换算后的量级对应；中国4402.501/4947.282亦符合百万公吨规模，L=T/V约束两列单位一致。这里“吨”是公吨，不是短吨或油当量吨。",
            "sourceUrls": [
              "https://www.eia.gov/coal/annual/",
              "https://www.bp.com/content/dam/bp/business-sites/en/global/corporate/pdfs/energy-economics/statistical-review/bp-stats-review-2019-full-report.pdf"
            ]
          }
        },
        "V": {
          "unit": "百万吨/年",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "煤炭消耗原值美国464.969/372.798，与EIA年度约512.5/410.9百万短吨经公吨换算后的量级对应；中国4402.501/4947.282亦符合百万公吨规模，L=T/V约束两列单位一致。这里“吨”是公吨，不是短吨或油当量吨。",
            "sourceUrls": [
              "https://www.eia.gov/coal/annual/",
              "https://www.bp.com/content/dam/bp/business-sites/en/global/corporate/pdfs/energy-economics/statistical-review/bp-stats-review-2019-full-report.pdf"
            ]
          }
        },
        "U": {
          "unit": "百万吨",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "煤炭储量原值美国250219、俄罗斯160364、中国138819、加拿大6582，与BP统计体系的储量百万吨尺度相符；与生产量百万吨/年区分为存量。BP报告与官方煤炭单位体系用于单位佐证，不将网页数据写回。",
            "sourceUrls": [
              "https://www.bp.com/content/dam/bp/business-sites/en/global/corporate/pdfs/energy-economics/statistical-review/bp-stats-review-2019-full-report.pdf",
              "https://www.eia.gov/coal/annual/"
            ]
          }
        },
        "W": {
          "unit": "桶/日",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "石油产量原值美国22844371/20463720、沙特10872023/3695113；EIA国际石油生产消费表使用百万桶/日，换成桶/日与原记录量级一致。H=X*1000000/W/365直接锁定日流量，G=W/Y约束两列一致。字段可能覆盖其他石油液体，单位确认不等于将其改称纯原油。",
            "sourceUrls": [
              "https://www.eia.gov/tools/faqs/faq.php?id=709&t=6"
            ]
          }
        },
        "Y": {
          "unit": "桶/日",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "石油消耗原值美国22844371/20463720、沙特10872023/3695113；EIA国际石油生产消费表使用百万桶/日，换成桶/日与原记录量级一致。H=X*1000000/W/365直接锁定日流量，G=W/Y约束两列一致。字段可能覆盖其他石油液体，单位确认不等于将其改称纯原油。",
            "sourceUrls": [
              "https://www.eia.gov/tools/faqs/faq.php?id=709&t=6"
            ]
          }
        },
        "X": {
          "unit": "百万桶",
          "unitEvidence": {
            "basis": "表头、公式与量级分析",
            "detail": "原式H=X*1000000/W/365，W已确认为桶/日，因此X是百万桶的存量；沙特267000、加拿大170000等数量级一致。不改储量范围、数值或年份。",
            "sourceUrls": [
              "https://www.eia.gov/tools/faqs/faq.php?id=709&t=6"
            ]
          }
        }
      }
    },
